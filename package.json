{
  "name": "issue-pilot",
  "version": "0.1.0",
  "description": "A local-first issue management agent for pi",
  "type": "module",
  "keywords": [
    "issue-tracker",
    "ticket-agent"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "server": "node --experimental-strip-types src/http/api.ts",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "db:seed": "node --experimental-strip-types src/db/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@fastify/multipart": "^10.1.0",
    "@libsql/client": "^0.17.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "typebox": "^1.3.9",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "undici": "8.9.0"
  }
}
