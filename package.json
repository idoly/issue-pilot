{
  "name": "issue-pilot",
  "version": "0.1.0",
  "description": "A local-first issue management agent for Pi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "issue-tracker",
    "ticket-agent"
  ],
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/apply-pi-sdk-patch.mjs",
    "dev:web": "vite --config src/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "test": "node --test 'tests/**/*.test.ts' && vitest run --config src/web/vite.config.ts --environment jsdom",
    "test:browser": "node tests/browser/acceptance.mjs",
    "test:performance": "node tests/browser/performance.mjs",
    "test:sls-cli": "node --test tests/integration/sls-cli.acceptance.ts",
    "test:ssh": "bash scripts/test-ssh.sh",
    "build": "vite build --config src/web/vite.config.ts",
    "db:migrate": "node src/db/migrate.ts",
    "format": "oxfmt --threads=1 --write .",
    "format:check": "oxfmt --threads=1 --check .",
    "lint": "oxlint --threads=1 --ignore-path .gitignore --deny-warnings --report-unused-disable-directives ."
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.83",
    "@bytebase/dbhub": "2.1.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-codemode": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "content-disposition": "3.1.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "p-map": "^7.1.1"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.3",
    "@types/node": "^26.6.6",
    "dompurify": "^3.5.0",
    "github-markdown-css": "5.9.0",
    "jsdom": "^31.0.1",
    "marked": "^18.2.1",
    "material-icon-theme": "5.40.0",
    "monaco-editor": "0.57.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "solid-js": "2.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "zod": "4.6.7",
    "dompurify": "$dompurify"
  }
}
