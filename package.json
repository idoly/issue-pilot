{
  "name": "issue-pilot",
  "version": "0.1.0",
  "description": "A local-first issue management agent for pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "issue-tracker",
    "ticket-agent"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "server": "node --experimental-strip-types src/http/api.ts",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "db:seed": "node --experimental-strip-types src/db/seed.ts"
  },
  "pi": {
    "extensions": [
      "./src/pi/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/websocket": "^11.3.0",
    "@libsql/client": "^0.17.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "node-pty": "^1.1.0",
    "valibot": "^1.4.2",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
