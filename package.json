{
  "name": "issue-pilot",
  "version": "0.1.0",
  "description": "A local-first issue management agent for Pi",
  "private": true,
  "type": "module",
  "keywords": [
    "issue-tracker",
    "ticket-agent"
  ],
  "license": "MIT",
  "scripts": {
    "dev:web": "vite --config src/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts && vitest run --config src/web/vite.config.ts --environment jsdom",
    "build": "vite build --config src/web/vite.config.ts",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts"
  },
  "dependencies": {
    "@alicloud/openapi-core": "1.0.8",
    "@alicloud/sls20201230": "5.12.0",
    "@darabonba/typescript": "1.0.5",
    "@e965/xlsx": "^0.20.3",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@redis/client": "^6.3.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "p-map": "^7.1.1",
    "typebox": "^1.3.37"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@solidjs/web": "2.0.0-rc.15",
    "@types/node": "^26.6.5",
    "dompurify": "^3.4.17",
    "github-markdown-css": "5.9.0",
    "jsdom": "^30.1.3",
    "lucide": "^1.58.0",
    "marked": "^18.1.1",
    "material-icon-theme": "5.39.0",
    "monaco-editor": "0.55.1",
    "solid-js": "2.0.0-rc.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "nanoid": "3.3.18",
    "seroval": "1.6.9",
    "seroval-plugins": "1.6.9",
    "undici": "8.12.2"
  }
}
