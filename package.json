{
  "name": "issue-pilot",
  "version": "0.1.0",
  "description": "A local-first issue management agent for Pi",
  "private": true,
  "type": "module",
  "keywords": [
    "issue-tracker",
    "ticket-agent"
  ],
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/apply-pi-sdk-patch.mjs",
    "dev:web": "vite --config src/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test 'tests/**/*.test.ts' && vitest run --config src/web/vite.config.ts --environment jsdom",
    "test:browser": "node --experimental-strip-types tests/browser/acceptance.mjs",
    "test:sls-cli": "node --experimental-strip-types --test tests/integration/sls-cli.acceptance.ts",
    "test:ssh": "bash scripts/test-ssh.sh",
    "build": "vite build --config src/web/vite.config.ts",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.82",
    "@bytebase/dbhub": "1.6.0",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "content-disposition": "3.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "p-map": "^7.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "2.0.0-rc.21",
    "@types/node": "^26.6.6",
    "dompurify": "^3.4.17",
    "github-markdown-css": "5.9.0",
    "jsdom": "^31.0.0",
    "marked": "^18.2.0",
    "material-icon-theme": "5.40.0",
    "monaco-editor": "0.57.0",
    "solid-js": "2.0.0-rc.21",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "zod": "4.6.7",
    "dompurify": "$dompurify"
  }
}
