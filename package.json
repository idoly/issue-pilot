{
  "name": "issue-pilot",
  "version": "0.1.0",
  "description": "A local-first issue management agent for Pi",
  "private": true,
  "type": "module",
  "keywords": [
    "issue-tracker",
    "ticket-agent"
  ],
  "license": "MIT",
  "scripts": {
    "dev:web": "vite --config src/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts && vitest run --config src/web/vite.config.ts --environment jsdom",
    "build": "vite build --config src/web/vite.config.ts",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "mysql2": "^3.23.3",
    "p-map": "^7.0.6",
    "redis": "^6.2.1",
    "typebox": "^1.3.16"
  },
