{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 200,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "/data/",
    "**/.issue-pilot",
    "**/node_modules",
    "**/src/web/dist",
    "**/.venv",
    "**/drizzle",
    "**/docs",
    "**/deploy",
    "**/patches/*.patch",
    "**/examples",
    "**/.github",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html",
    "**/package-lock.json",
    "**/*.md"
  ],
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "off",
  "sortPackageJson": false
}
