{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "vitest", "import", "promise"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "array-callback-return": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports",
        "disallowTypeAnnotations": false
      }
    ],
    "no-promise-executor-return": "error"
  },
  "ignorePatterns": [
    "/data/",
    "**/.issue-pilot",
    "**/node_modules",
    "**/src/web/dist",
    "**/.venv",
    "**/drizzle",
    "**/docs",
    "**/deploy",
    "**/patches",
    "**/examples",
    "**/.github",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html",
    "**/package-lock.json",
    "**/*.md"
  ]
}
