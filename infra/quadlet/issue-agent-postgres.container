[Unit]
Description=Issue Agent PostgreSQL

[Container]
Image=docker.io/library/postgres:17.5-alpine
ContainerName=issue-agent-postgres
EnvironmentFile=%h/.config/issue-agent/env
Environment=POSTGRES_DB=issue_agent
Environment=POSTGRES_USER=issue_agent
Volume=issue-agent-postgres.volume:/var/lib/postgresql/data
Volume=%h/.config/issue-agent/init-databases.sh:/docker-entrypoint-initdb.d/10-init-databases.sh:ro,Z
Network=issue-agent.network
PublishPort=127.0.0.1:5432:5432
HealthCmd=pg_isready -U issue_agent -d issue_agent
HealthInterval=5s
HealthTimeout=3s
HealthRetries=20
NoNewPrivileges=true

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
