[Unit]
Description=Issue Agent Keycloak
Requires=issue-agent-postgres.service
After=issue-agent-postgres.service

[Container]
Image=quay.io/keycloak/keycloak:26.3.1
ContainerName=issue-agent-keycloak
EnvironmentFile=%h/.config/issue-agent/env
Environment=KC_DB=postgres
Environment=KC_DB_URL=jdbc:postgresql://issue-agent-postgres:5432/keycloak
Environment=KC_DB_USERNAME=keycloak
Environment=KC_PROXY_HEADERS=xforwarded
Environment=KC_HEALTH_ENABLED=true
Network=issue-agent.network
PublishPort=127.0.0.1:8081:8080
Exec=start-dev
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
